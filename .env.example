# Supabase PostgreSQL direct connection (used by scripts/migrate.mjs and server DB checks)
# URL-encode special characters like '$' as '%24' if your env loader expands variables
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Project URL & API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (server-side)
GEMINI_API_KEY=your-gemini-api-key
